#!/bin/bash

# ROS1源码清理脚本
# 删除src目录下所有.c、.cpp、.h、.hpp文件
sudo rm -rf ./build
set -e  # 遇到错误时退出脚本

echo "=== ROS1源码清理脚本 ==="
echo "将删除src目录下所有.c、.cpp、.h、.hpp文件"
echo ""

# 检查当前目录是否是ROS工作空间
if [ ! -d "src" ]; then
    echo "错误：当前目录中没有找到src文件夹！"
    echo "请确保在ROS工作空间根目录下运行此脚本"
    exit 1
fi

# 显示将要删除的文件统计
echo "扫描文件..."
c_count=$(find src -name "*.c" -type f | wc -l)
cpp_count=$(find src -name "*.cpp" -type f | wc -l)
h_count=$(find src -name "*.h" -type f | wc -l)
hpp_count=$(find src -name "*.hpp" -type f | wc -l)
total=$((c_count + cpp_count + h_count + hpp_count))

echo "找到的文件统计："
echo "  .c文件:   $c_count"
echo "  .cpp文件: $cpp_count"
echo "  .h文件:   $h_count"
echo "  .hpp文件: $hpp_count"
echo "  总计:     $total"

if [ $total -eq 0 ]; then
    echo "没有找到需要删除的文件，退出脚本。"
    exit 0
fi

# 询问用户确认
read -p "确定要删除以上所有文件吗？(y/N): " confirm
if [[ ! $confirm =~ ^[Yy]$ ]]; then
    echo "操作已取消。"
    exit 0
fi

# 删除文件
echo "开始删除文件..."
if [ $c_count -gt 0 ]; then
    echo "删除.c文件..."
    find src -name "*.c" -type f -delete
fi

if [ $cpp_count -gt 0 ]; then
    echo "删除.cpp文件..."
    find src -name "*.cpp" -type f -delete
fi

if [ $h_count -gt 0 ]; then
    echo "删除.h文件..."
    find src -name "*.h" -type f -delete
fi

if [ $hpp_count -gt 0 ]; then
    echo "删除.hpp文件..."
    find src -name "*.hpp" -type f -delete
fi

echo ""
echo "=== 清理完成 ==="
echo "已删除 $total 个文件"

# 验证删除结果
echo ""
echo "验证结果："
remaining_c=$(find src -name "*.c" -type f 2>/dev/null | wc -l)
remaining_cpp=$(find src -name "*.cpp" -type f 2>/dev/null | wc -l)
remaining_h=$(find src -name "*.h" -type f 2>/dev/null | wc -l)
remaining_hpp=$(find src -name "*.hpp" -type f 2>/dev/null | wc -l)
remaining_total=$((remaining_c + remaining_cpp + remaining_h + remaining_hpp))

if [ $remaining_total -eq 0 ]; then
    echo "所有目标文件已成功删除！"
else
    echo "警告：仍有 $remaining_total 个文件未被删除"
    echo "  .c文件剩余:   $remaining_c"
    echo "  .cpp文件剩余: $remaining_cpp"
    echo "  .h文件剩余:   $remaining_h"
    echo "  .hpp文件剩余: $remaining_hpp"
fi


